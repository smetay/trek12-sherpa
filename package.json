{
  "name": "trek12-sherpa",
  "version": "1.1.0",
  "private": true,
  "description": "Unofficial best-move advisor for the roll-and-write game Trek 12 (offline PWA, Monte-Carlo solver)",
  "license": "MIT",
  "author": "S\u00e9bastien Metay",
  "repository": "github:smetay/trek12-sherpa",
  "homepage": "https://smetay.github.io/trek12-sherpa/",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @trek12/web dev",
    "build": "pnpm --filter @trek12/web build",
    "preview": "pnpm --filter @trek12/web preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --parallel typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "hygiene": "bash scripts/check-hygiene.sh",
    "check": "biome ci . && pnpm typecheck && pnpm test && pnpm build && pnpm hygiene",
    "bench": "node --env-file-if-exists=.env apps/bench/src/cli.ts",
    "e2e": "pnpm --filter @trek12/web e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
